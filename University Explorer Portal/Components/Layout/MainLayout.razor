@inherits LayoutComponentBase
@inject LocalStorageService LocalStorage
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center @(isDarkMode ? "bg-dark text-light border-secondary" : "")">
            <span class="fw-semibold">University Explorer Portal</span>
            <button type="button"
                    class="btn btn-sm @(isDarkMode ? "btn-outline-light" : "btn-outline-dark")"
                    @onclick="ToggleDarkMode">
                @(isDarkMode ? "☀️ Light Mode" : "🌙 Dark Mode")
            </button>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isDarkMode = await LocalStorage.GetItemAsync<bool>("darkMode");
            await ApplyThemeAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await LocalStorage.SetItemAsync("darkMode", isDarkMode);
        await ApplyThemeAsync();
    }

    private async Task ApplyThemeAsync()
    {
        var theme = isDarkMode ? "dark" : "light";
        await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-bs-theme", theme);
    }
}