@page "/student-applications"
@rendermode InteractiveServer
@inject StudentApplicationService ApplicationService
@inject NavigationManager Navigation

<PageTitle>Student Applications</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">Student Applications</h2>
        <a href="/student-applications/create" class="btn btn-success">
            + Create New Application
        </a>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            Loading student applications...
        </div>
    }
    else if (hasError)
    {
        <div class="alert alert-danger">
            Unable to retrieve student applications data.
        </div>
    }
    else if (!applications.Any())
    {
        <div class="alert alert-warning">
            No student applications found. Click "Create New Application" to submit one.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Student Name</th>
                        <th>University Name</th>
                        <th>Country</th>
                        <th>Course Name</th>
                        <th>Application Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in applications)
                    {
                        <tr>
                            <td>@app.Id</td>
                            <td>@app.StudentName</td>
                            <td>@app.UniversityName</td>
                            <td>@app.Country</td>
                            <td>@app.CourseName</td>
                            <td>@app.ApplicationDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditApplication(app.Id)">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<StudentApplication> applications = new();
    private bool isLoading = true;
    private bool hasError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplicationsAsync();
    }

    private async Task LoadApplicationsAsync()
    {
        isLoading = true;
        hasError = false;

        try
        {
            applications = await ApplicationService.GetApplicationsAsync();
        }
        catch (Exception)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Navigates to the Edit page for the selected application
    private void EditApplication(int id)
    {
        Navigation.NavigateTo($"/student-applications/edit/{id}");
    }
}