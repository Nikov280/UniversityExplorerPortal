@page "/university-explorer"
@rendermode InteractiveServer
@inject CountryService CountryService
@inject UniversityService UniversityService
@inject LocalStorageService LocalStorage

<PageTitle>University Explorer</PageTitle>

<div class="container py-4">
    <h2 class="mb-3 text-primary">University Explorer</h2>
    <p class="text-muted">Select a country to inspect country information and search available universities.</p>

    @* Country Loading & Error States *@
    @if (isLoadingCountries)
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            Loading countries...
        </div>
    }
    else if (hasCountryError)
    {
        <div class="alert alert-danger">
            Unable to retrieve countries data. Please try again later.
        </div>
    }
    else
    {
        @* Requirement 2: Country Selection Dropdown *@
        <div class="row mb-4">
            <div class="col-md-6">
                <label for="countrySelect" class="form-label fw-bold">Select Country</label>
                <select id="countrySelect" class="form-select" value="@selectedCountryName" @onchange="OnCountryChanged">
                    <option value="">-- Select a Country --</option>
                    @foreach (var country in countries)
                    {
                        <option value="@country.DisplayName">@country.DisplayName</option>
                    }
                </select>
            </div>
        </div>
    }

    @* Requirement 3: Country Details Card *@
    @if (selectedCountry != null)
    {
        <CountryDetails Country="selectedCountry" />
    }

    @* Requirement 6: Selected University Details *@
    @if (selectedUniversity != null)
    {
        <UniversityDetails University="selectedUniversity" OnClose="ClearSelectedUniversity" />
    }

    @* Requirement 4 & 5 + Distinction Features: Search, Sort, Favourites & Pagination *@
    @if (!string.IsNullOrWhiteSpace(selectedCountryName))
    {
        <hr class="my-4" />
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
            <h4 class="mb-0">Universities in @selectedCountryName (@FilteredUniversities.Count())</h4>

            <div class="col-md-4">
                <input class="form-control"
                       value="@SearchText"
                       @oninput="OnSearchChanged"
                       placeholder="Search university..." />
            </div>
        </div>

        @* Sorting & Favourites Filter Bar *@
        <div class="row g-3 align-items-center mb-4">
            <div class="col-sm-6 col-md-4">
                <label for="sortSelect" class="form-label fw-semibold mb-1">Sort by Name</label>
                <select id="sortSelect" class="form-select form-select-sm" @bind="sortOrder" @bind:after="ResetPagination">
                    <option value="asc">Name (A → Z)</option>
                    <option value="desc">Name (Z → A)</option>
                </select>
            </div>

            <div class="col-sm-6 col-md-5 d-flex align-items-end">
                <div class="form-check form-switch mt-sm-4">
                    <input class="form-check-input"
                           type="checkbox"
                           id="favOnlySwitch"
                           @bind="showOnlyFavourites"
                           @bind:after="ResetPagination" />
                    <label class="form-check-label fw-semibold" for="favOnlySwitch">
                        ★ Show Favourites Only (@favouriteUniversities.Count)
                    </label>
                </div>
            </div>
        </div>

        @if (isLoadingUniversities)
        {
            <div class="alert alert-info">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                Loading universities for @selectedCountryName...
            </div>
        }
        else if (hasUniversityError)
        {
            <div class="alert alert-danger">
                Unable to retrieve universities data for @selectedCountryName.
            </div>
        }
        else if (!FilteredUniversities.Any())
        {
            <div class="alert alert-warning">
                No universities found matching your criteria.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var university in PagedUniversities)
                {
                    <div class="col">
                        <UniversityCard University="university"
                                        OnSelect="HandleUniversitySelected"
                                        IsFavourite="favouriteUniversities.Contains(university.Name)"
                                        OnToggleFavourite="ToggleFavourite" />
                    </div>
                }
            </div>

            @* Pagination Controls *@
            @if (TotalPages > 1)
            {
                <nav aria-label="Universities pagination" class="mt-4">
                    <ul class="pagination justify-content-center flex-wrap">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
                        </li>

                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                            </li>
                        }

                        <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                        </li>
                    </ul>
                </nav>
            }
        }
    }
</div>

@code {
    private List<Country> countries = new();
    private Country? selectedCountry;
    private string selectedCountryName = string.Empty;

    private List<University> universities = new();
    private University? selectedUniversity;
    private string SearchText { get; set; } = string.Empty;

    private bool isLoadingCountries = true;
    private bool hasCountryError = false;

    private bool isLoadingUniversities = false;
    private bool hasUniversityError = false;

    // Favourites, Sorting & Pagination state
    private HashSet<string> favouriteUniversities = new(StringComparer.OrdinalIgnoreCase);
    private List<University> favouriteUniversityList = new();
    private bool showOnlyFavourites = false;
    private string sortOrder = "asc";
    private int currentPage = 1;
    private const int PageSize = 6;

    // Combined filter (SearchText + Favourites) and sorting (A-Z / Z-A)
    private IEnumerable<University> FilteredUniversities
    {
        get
        {
            var query = universities.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                query = query.Where(u => u.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase));
            }

            if (showOnlyFavourites)
            {
                query = query.Where(u => favouriteUniversities.Contains(u.Name));
            }

            query = sortOrder == "desc"
                ? query.OrderByDescending(u => u.Name)
                : query.OrderBy(u => u.Name);

            return query;
        }
    }

    private int TotalPages => (int)Math.Ceiling(FilteredUniversities.Count() / (double)PageSize);

    private IEnumerable<University> PagedUniversities =>
        FilteredUniversities.Skip((currentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadCountriesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedList = await LocalStorage.GetItemAsync<List<University>>("favouriteUniversityObjects");
            if (savedList is not null)
            {
                favouriteUniversityList = savedList;
                favouriteUniversities = new HashSet<string>(
                    savedList.Select(u => u.Name),
                    StringComparer.OrdinalIgnoreCase);
                StateHasChanged();
            }
            else
            {
                // Fallback in case only string names were saved previously
                var savedNames = await LocalStorage.GetItemAsync<List<string>>("favouriteUniversities");
                if (savedNames is not null)
                {
                    favouriteUniversities = new HashSet<string>(savedNames, StringComparer.OrdinalIgnoreCase);
                    StateHasChanged();
                }
            }
        }
    }

    private async Task LoadCountriesAsync()
    {
        isLoadingCountries = true;
        hasCountryError = false;

        try
        {
            countries = await CountryService.GetCountriesAsync();
        }
        catch (Exception)
        {
            hasCountryError = true;
        }
        finally
        {
            isLoadingCountries = false;
        }
    }

    // Handles country dropdown selection and fetches corresponding universities
    private async Task OnCountryChanged(ChangeEventArgs e)
    {
        selectedCountryName = e.Value?.ToString() ?? string.Empty;
        selectedUniversity = null;
        SearchText = string.Empty;
        currentPage = 1;
        universities.Clear();

        if (string.IsNullOrWhiteSpace(selectedCountryName))
        {
            selectedCountry = null;
            return;
        }

        selectedCountry = countries.FirstOrDefault(c =>
            c.DisplayName.Equals(selectedCountryName, StringComparison.OrdinalIgnoreCase));

        await LoadUniversitiesAsync(selectedCountryName);
    }

    private async Task LoadUniversitiesAsync(string countryName)
    {
        isLoadingUniversities = true;
        hasUniversityError = false;

        try
        {
            universities = await UniversityService.GetUniversitiesByCountryAsync(countryName);
        }
        catch (Exception)
        {
            hasUniversityError = true;
        }
        finally
        {
            isLoadingUniversities = false;
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
        }
    }

    private void ResetPagination()
    {
        currentPage = 1;
    }

    private async Task ToggleFavourite(string universityName)
    {
        if (favouriteUniversities.Contains(universityName))
        {
            favouriteUniversities.Remove(universityName);
            favouriteUniversityList.RemoveAll(u => u.Name.Equals(universityName, StringComparison.OrdinalIgnoreCase));
        }
        else
        {
            favouriteUniversities.Add(universityName);
            var uniObj = universities.FirstOrDefault(u => u.Name.Equals(universityName, StringComparison.OrdinalIgnoreCase));
            if (uniObj is not null)
            {
                favouriteUniversityList.Add(uniObj);
            }
        }

        await LocalStorage.SetItemAsync("favouriteUniversities", favouriteUniversities.ToList());
        await LocalStorage.SetItemAsync("favouriteUniversityObjects", favouriteUniversityList);

        if (showOnlyFavourites && currentPage > TotalPages && TotalPages > 0)
        {
            currentPage = TotalPages;
        }
    }

    // EventCallback handler when user selects a university card
    private void HandleUniversitySelected(University university)
    {
        selectedUniversity = university;
    }

    private void ClearSelectedUniversity()
    {
        selectedUniversity = null;
    }
}