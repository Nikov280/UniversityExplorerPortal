@* Reusable component displaying detailed information about the selected university *@
@if (University != null)
{
    <div class="card shadow border-success mb-4">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Selected University Details</h5>
            <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="HandleClose"></button>
        </div>
        <div class="card-body">
            <h4 class="card-title">@University.Name</h4>
            <hr />
            <p class="mb-2"><strong>University Name:</strong> @University.Name</p>
            <p class="mb-2"><strong>Country:</strong> @University.Country</p>
            <p class="mb-2">
                <strong>Website:</strong>
                @if (University.PrimaryWebsite != "N/A")
                {
                    <a href="@University.PrimaryWebsite" target="_blank" rel="noopener noreferrer">
                        @University.PrimaryWebsite
                    </a>
                }
                else
                {
                    <span>N/A</span>
                }
            </p>
            <p class="mb-3"><strong>Domain:</strong> @University.PrimaryDomain</p>

            <a class="btn btn-success"
               href="/student-applications/create?country=@Uri.EscapeDataString(University.Country)&university=@Uri.EscapeDataString(University.Name)">
                Apply to this University
            </a>
        </div>
    </div>
}

@code {
    [Parameter]
    public University? University { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}