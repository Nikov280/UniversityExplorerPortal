@* Reusable card component displaying summary information about a single university *@
<div class="card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <h5 class="card-title text-primary mb-0">@University.Name</h5>

            <button type="button"
                    class="btn btn-sm @(IsFavourite ? "btn-warning" : "btn-outline-secondary")"
                    @onclick="HandleToggleFavourite"
                    title="Toggle Favourite">
                @(IsFavourite ? "★" : "☆")
            </button>
        </div>

        <p class="card-text mb-1">
            <strong>Country:</strong> @University.Country
        </p>
        <p class="card-text mb-3">
            <strong>Website:</strong>
            @if (University.PrimaryWebsite != "N/A")
            {
                <a href="@University.PrimaryWebsite" target="_blank" rel="noopener noreferrer">
                    @University.PrimaryWebsite
                </a>
            }
            else
            {
                <span>N/A</span>
            }
        </p>
        <div class="mt-auto">
            <button class="btn btn-outline-primary btn-sm w-100" @onclick="HandleSelect">
                View Details
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public University University { get; set; } = new();

    [Parameter]
    public EventCallback<University> OnSelect { get; set; }

    [Parameter]
    public bool IsFavourite { get; set; }

    [Parameter]
    public EventCallback<string> OnToggleFavourite { get; set; }

    // Triggers the parent callback when a university is selected
    private async Task HandleSelect()
    {
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(University);
        }
    }

    // Triggers the parent callback to save/remove the university from favourites
    private async Task HandleToggleFavourite()
    {
        if (OnToggleFavourite.HasDelegate && !string.IsNullOrWhiteSpace(University.Name))
        {
            await OnToggleFavourite.InvokeAsync(University.Name);
        }
    }
}